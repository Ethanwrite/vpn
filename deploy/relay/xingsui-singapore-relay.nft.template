# Render this template on the relay host. Never commit the upstream address.
# The awg entry accepts BOTH the legacy high port and UDP 4500 (IPsec NAT-T):
# mobile carriers must pass 4500 for VoWiFi, while high UDP ports often get
# throttled/killed — see ARCHITECTURE.md 端口策略.
table ip xingsui_singapore_relay {
    chain prerouting {
        type nat hook prerouting priority dstnat - 10; policy accept;
        udp dport { __AWG_LISTEN_PORT__, 4500 } dnat to __UPSTREAM_IP__:__AWG_UPSTREAM_PORT__
        tcp dport __VLESS_LISTEN_PORT__ dnat to __UPSTREAM_IP__:__VLESS_UPSTREAM_PORT__
    }

    chain postrouting {
        type nat hook postrouting priority srcnat + 10; policy accept;
        ip daddr __UPSTREAM_IP__ udp dport __AWG_UPSTREAM_PORT__ masquerade
        ip daddr __UPSTREAM_IP__ tcp dport __VLESS_UPSTREAM_PORT__ masquerade
    }

    chain forward {
        type filter hook forward priority filter - 10; policy accept;
        ip daddr __UPSTREAM_IP__ udp dport __AWG_UPSTREAM_PORT__ accept
        ip saddr __UPSTREAM_IP__ udp sport __AWG_UPSTREAM_PORT__ ct state established,related accept
        ip daddr __UPSTREAM_IP__ tcp dport __VLESS_UPSTREAM_PORT__ accept
        ip saddr __UPSTREAM_IP__ tcp sport __VLESS_UPSTREAM_PORT__ ct state established,related accept
    }
}
