# ============================================================
# 星隧 VPN 控制面环境变量样板
# 复制为 .env 后填写真实值。.env 绝不可提交到 Git。
# 所有占位符均无真实密钥，请用强随机值替换。
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=xingsui
POSTGRES_USER=xingsui
# 用 openssl rand -base64 24 生成
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# 后端连库地址（compose 已自动覆盖为 db 服务名，此处保持占位即可）
DATABASE_URL=postgresql+psycopg://xingsui:CHANGE_ME_STRONG_DB_PASSWORD@db:5432/xingsui

# ---------- 站点 / 反代 ----------
# 已解析到本机(212)的域名，空格分隔；Caddy 会为每个域名自动签发并续期证书。
# xingsui.org 为官网主域名；xingsuico.com 为等价备用镜像（大陆抗封冗余，两者各自独立可用）。
SITE_DOMAIN=xingsui.org www.xingsui.org
# Let's Encrypt 到期通知邮箱（建议填写真实邮箱）
ACME_EMAIL=admin@xingsui.org
# 官网与订阅链接统一使用主域名。
SITE_BASE_URL=https://xingsui.org
SUBSCRIPTION_PUBLIC_BASE_URL=https://xingsui.org
# App / 官网跨域来源，逗号分隔；生产建议收敛为具体域名。含备用镜像域名。
CORS_ALLOW_ORIGINS=https://xingsui.org,https://www.xingsui.org,https://xingsuico.com,https://www.xingsuico.com
APP_ENV=production
ENABLE_API_DOCS=false
SEED_DEMO_USER=false

# ---------- H5 支付页 ----------
# 微信/支付宝 App 唤起链接；以下当前值由现有收款码解析，可按需替换。
PAYMENT_WECHAT_DEEP_LINK=wxp://f2f0weex6pzVCbHJS0F58zNgP0qFISXfVQ7wfUjkZm-mVouPfNvF0TLyia4FlY70GzZh
PAYMENT_ALIPAY_DEEP_LINK=https://qr.alipay.com/fkx17726pq0vcp2sj5fhgc7
# 二维码用站内相对路径，随当前访问域名加载（主域名或 xingsuico.com 镜像均可），
# 避免镜像页在主域名被封时二维码加载失败。/pay/* 由 API 提供。
PAYMENT_WECHAT_QR_URL=/pay/wechat.jpg
PAYMENT_ALIPAY_QR_URL=/pay/alipay.jpg
PAYMENT_SUPPORT_URL=https://t.me/+peCBtyuzOzNjNzA1

# ---------- Admin 后台 ----------
# 必须覆盖代码内默认值！用 openssl rand -base64 18 生成
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET
# 事故处置期间保持 false；完成复核后再按变更流程开启。
ADMIN_WRITES_ENABLED=false
ADMIN_MAX_GRANT_DAYS=3660

# ---------- App 版本控制 ----------
APP_VERSION_CODE=15
APP_VERSION_NAME=2.0.5
MIN_SUPPORTED_APP_VERSION_CODE=15

# ============================================================
# VPN 安全租约与节点 Agent
# 节点连接参数只存在 vpn_nodes 数据库表；不存在全局静态配置回退。
# ============================================================

# ---------- 节点 Agent（方案 A）安全与通信 ----------
# 每节点独立 HMAC secret。生产用 Docker secret 挂载 root:600 JSON：
# {"node-id-a":"64+ random hex","node-id-b":"different random hex"}
NODE_AGENT_SECRETS_FILE=/run/secrets/xingsui-node-agent-secrets.json
# 仅供本地测试，生产不要把 secret 直接写在 Compose 环境中。
NODE_AGENT_SECRETS_JSON=
NODE_AGENT_SCHEME=https
NODE_AGENT_CA_FILE=/run/secrets/xingsui-node-agent-ca.pem
# 如 Agent 要求 mTLS，同时配置以下两项。
NODE_AGENT_CLIENT_CERT=
NODE_AGENT_CLIENT_KEY=
# 默认 Agent 端口（节点表可逐节点覆盖 agent_port）
NODE_AGENT_PORT=51821
# 心跳超过该秒数未更新则判定节点离线
NODE_OFFLINE_AFTER_SECONDS=120
# 调用边缘节点 Agent 的超时（秒）
AGENT_HTTP_TIMEOUT=6
ACCESS_TOKEN_TTL_SECONDS=86400
VPN_LEASE_TTL_SECONDS=300
VPN_LEASE_SWEEP_SECONDS=30

# Emergency client kill switch. Keep false until the Windows endpoint review is complete.
WINDOWS_CLIENT_ENABLED=false
