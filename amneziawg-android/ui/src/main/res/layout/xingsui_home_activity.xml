<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xingsui_home_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/account_card"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/xingsui_home_panel"
                android:contentDescription="@string/xingsui_profile_open"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="6dp">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/xingsui_avatar_bg"
                    android:gravity="center"
                    android:text="星"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/account_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="@string/xingsui_home_guest"
                        android:textColor="#EAF0FFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/traffic_remaining"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/xingsui_home_login_to_sync"
                        android:textColor="#93A0B7"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vip_button"
                android:layout_width="76dp"
                android:layout_height="44dp"
                android:fontFamily="sans"
                android:text="@string/xingsui_home_recharge"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:background="@drawable/xingsui_primary_button_bg"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- 标题贴头像下方、智能模式开关贴充值下方，中部只留连接按钮，视觉更简约。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/connection_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/xingsui_home_disconnected"
                    android:textColor="#99A5BC"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/xingsui_segment_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xingsui_home_smart_mode"
                    android:textColor="#D9DEFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/smart_mode_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minWidth="48dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/auth_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/login_button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/xingsui_login"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:background="@drawable/xingsui_primary_button_bg"
                app:backgroundTint="@null"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/register_button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/xingsui_register"
                android:textColor="#D9DEFFFF"
                android:textStyle="bold"
                android:background="@drawable/xingsui_outline_button_bg"
                app:backgroundTint="@null"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- 长屏适配：与连接按钮下方的等权 Space 对称分布多余高度，
             使连接区块在头部与底部卡片之间居中；小屏上收缩为 0，照常滚动。 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="296dp"
            android:layout_marginTop="8dp">

            <View
                android:id="@+id/power_ring"
                android:layout_width="244dp"
                android:layout_height="244dp"
                android:layout_gravity="center"
                android:background="@drawable/xingsui_power_ring" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connect_button"
                android:layout_width="158dp"
                android:layout_height="158dp"
                android:layout_gravity="center"
                android:background="@drawable/xingsui_connect_button_bg"
                android:fontFamily="sans"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/xingsui_home_connect"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="79dp"
                app:elevation="14dp" />
        </FrameLayout>

        <!-- 与连接按钮上方的 Space 等权，保证连接区块上下留白对称。 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:background="@drawable/xingsui_home_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/xingsui_status_dot_bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xingsui_home_current_node"
                    android:textColor="#7E89A3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/node_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/xingsui_home_auto_node"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/node_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/xingsui_node_auto_detail"
                    android:textColor="#A7AEC2"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/node_manage_button"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:contentDescription="@string/xingsui_node_picker_title"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/xingsui_home_node_manage"
                android:textColor="#D9DEFFFF"
                android:textSize="16sp"
                android:background="@drawable/xingsui_outline_button_bg"
                app:backgroundTint="@null"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/xingsui_home_smart_match"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:background="@drawable/xingsui_primary_button_bg"
            app:backgroundTint="@null"
            app:cornerRadius="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/xingsui_home_panel"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xingsui_home_vip_status"
                    android:textColor="#7E89A3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/vip_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/xingsui_home_vip_inactive"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/xingsui_home_panel"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/xingsui_home_expiry"
                    android:textColor="#7E89A3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/vip_expiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/xingsui_home_no_expiry"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
