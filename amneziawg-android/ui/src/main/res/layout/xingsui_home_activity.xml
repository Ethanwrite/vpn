<?xml version="1.0" encoding="utf-8"?>
<!--
  星火 VPN 首页：奶油白纸面、黑色大标题、黑金标志、构成主义几何线条。
  中央的 XingsuiEmblemView 负责全部连接动效（锤镰滑入扣合 → 脉冲 → 圆环闭合转金）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/xingsui_home_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="36dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- ===== 顶部：头像入口 + 充值 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/account_card"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/xingsui_profile_open"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_xingsui_emblem" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/account_email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="@string/xingsui_home_guest"
                        android:textColor="@color/xingsui_ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/traffic_remaining"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/xingsui_home_login_to_sync"
                        android:textColor="@color/xingsui_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vip_button"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/xingsui_gold_button_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0.06"
                android:minWidth="84dp"
                android:text="@string/xingsui_home_recharge"
                android:textColor="@color/xingsui_ink"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="3dp"
                app:elevation="0dp" />
        </LinearLayout>

        <!-- ===== 品牌标题 + 全局开关 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.24"
                    android:text="@string/xingsui_brand_latin"
                    android:textColor="@color/xingsui_gold_deep"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/xingsui_home_headline"
                    android:textColor="@color/xingsui_ink"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/xingsui_segment_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/xingsui_home_smart_mode"
                    android:textColor="@color/xingsui_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/smart_mode_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minWidth="48dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/auth_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/login_button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/xingsui_primary_button_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/xingsui_login"
                android:textColor="@color/xingsui_paper_raised"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="3dp"
                app:elevation="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/register_button"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/xingsui_outline_button_bg"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/xingsui_register"
                android:textColor="@color/xingsui_ink"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="3dp"
                app:elevation="0dp" />
        </LinearLayout>

        <!-- 长屏适配：与下方等权 Space 对称分布多余高度，让标志区块居中；小屏收缩为 0。 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ===== 中央：黑金锤镰连接动效 ===== -->
        <org.amnezia.awg.xingsui.XingsuiEmblemView
            android:id="@+id/emblem"
            android:layout_width="match_parent"
            android:layout_height="272dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/xingsui_home_connect" />

        <TextView
            android:id="@+id/connection_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:text="@string/xingsui_home_disconnected"
            android:textColor="@color/xingsui_ink"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connection_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="@string/xingsui_home_detail_idle"
            android:textColor="@color/xingsui_muted"
            android:textSize="12.5sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/xingsui_primary_button_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.08"
            android:text="@string/xingsui_home_connect"
            android:textColor="@color/xingsui_paper_raised"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="3dp"
            app:elevation="0dp" />

        <!-- ===== 当前线路 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/xingsui_home_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/xingsui_status_dot_bg" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="@string/xingsui_home_current_node"
                    android:textColor="@color/xingsui_faint"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/node_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/xingsui_home_auto_node"
                    android:textColor="@color/xingsui_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/node_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/xingsui_node_auto_detail"
                    android:textColor="@color/xingsui_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/node_manage_button"
                android:layout_width="46dp"
                android:layout_height="38dp"
                android:background="@drawable/xingsui_outline_button_bg"
                android:contentDescription="@string/xingsui_node_picker_title"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/xingsui_home_node_manage"
                android:textColor="@color/xingsui_ink"
                android:textSize="15sp"
                app:backgroundTint="@null"
                app:cornerRadius="3dp"
                app:elevation="0dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/xingsui_outline_button_bg"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/xingsui_home_smart_match"
            android:textColor="@color/xingsui_ink"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="3dp"
            app:elevation="0dp" />

        <!-- ===== 会员状态 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/xingsui_home_panel"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="@string/xingsui_home_vip_status"
                    android:textColor="@color/xingsui_faint"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/vip_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/xingsui_home_vip_inactive"
                    android:textColor="@color/xingsui_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="86dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/xingsui_home_panel"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="@string/xingsui_home_expiry"
                    android:textColor="@color/xingsui_faint"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/vip_expiry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/xingsui_home_no_expiry"
                    android:textColor="@color/xingsui_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
