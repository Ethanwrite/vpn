<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/xingsui_paper">
  <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="24dp">
    <com.google.android.material.button.MaterialButton android:id="@+id/back_button" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:insetLeft="0dp" android:insetRight="0dp" android:padding="0dp" android:text="‹" android:textSize="28sp" android:contentDescription="@string/xingsui_back" app:backgroundTint="@android:color/transparent" android:textColor="@color/xingsui_ink" app:cornerRadius="24dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="会员计划" android:textSize="22sp" android:textColor="@color/xingsui_ink" android:layout_marginStart="10dp" android:textStyle="bold" />
  </LinearLayout>
  <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="28dp">
      <androidx.recyclerview.widget.RecyclerView android:id="@+id/plan_carousel" android:layout_width="match_parent" android:layout_height="370dp" android:clipToPadding="false" android:clipChildren="false" android:overScrollMode="never" android:scrollbars="none" android:paddingTop="8dp" android:paddingBottom="12dp" android:contentDescription="会员套餐，左右滑动选择" />
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在加载套餐" android:textSize="12sp" android:textColor="@color/xingsui_muted" android:id="@+id/plan_position" android:gravity="center" android:textColorHint="@color/xingsui_muted" android:layout_marginTop="2dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/submit_paid" android:layout_width="match_parent" android:layout_height="56dp" android:text="前往官网开通" android:textAllCaps="false" app:cornerRadius="20dp" android:insetTop="0dp" android:insetBottom="0dp" android:enabled="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="最终优惠以确认页为准 · 支持微信 / 支付宝" android:textSize="11sp" android:textColor="@color/xingsui_muted" android:id="@+id/order_status" android:gravity="center" android:layout_marginTop="10dp" android:lineSpacingExtra="3dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/retry_plans" android:layout_width="match_parent" android:layout_height="56dp" android:text="重新加载套餐" android:textAllCaps="false" app:cornerRadius="20dp" android:insetTop="0dp" android:insetBottom="0dp" android:visibility="gone" android:layout_marginTop="8dp" style="?attr/materialButtonOutlinedStyle" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="32dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/xingsui_paper_raised" app:strokeColor="#12282825" app:strokeWidth="1dp" app:contentPadding="0dp" android:layout_marginTop="28dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="邀请同行" android:textSize="22sp" android:textColor="@color/xingsui_ink" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/xingsui_invite_reward" android:textSize="12sp" android:textColor="@color/xingsui_muted" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:layout_marginTop="20dp" android:background="@drawable/xingsui_invite_code_surface">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="你的专属邀请码" android:textSize="11sp" android:textColor="@color/xingsui_muted" />
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="26sp" android:textColor="@color/xingsui_ink" android:id="@+id/invite_code" android:layout_marginTop="8dp" android:fontFamily="monospace" android:letterSpacing="0.12" android:textStyle="bold" android:textIsSelectable="true" />
              <com.google.android.material.button.MaterialButton android:id="@+id/copy_invite" android:layout_width="match_parent" android:layout_height="56dp" android:text="复制邀请码" android:textAllCaps="false" app:cornerRadius="20dp" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="12dp" style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="22dp" android:baselineAligned="false">
              <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="26sp" android:textColor="@color/xingsui_ink" android:id="@+id/invited_count" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="已邀请" android:textSize="11sp" android:textColor="@color/xingsui_muted" android:layout_marginTop="5dp" />
              </LinearLayout>
              <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="26sp" android:textColor="@color/xingsui_ink" android:id="@+id/paid_count" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="已开通" android:textSize="11sp" android:textColor="@color/xingsui_muted" android:layout_marginTop="5dp" />
              </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="邀请数据加载中" android:textSize="11sp" android:textColor="@color/xingsui_muted" android:id="@+id/invitation_status" android:layout_marginTop="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/retry_invitation" android:layout_width="match_parent" android:layout_height="56dp" android:text="重新加载邀请数据" android:textAllCaps="false" app:cornerRadius="20dp" android:insetTop="0dp" android:insetBottom="0dp" android:visibility="gone" android:layout_marginTop="8dp" style="?attr/materialButtonOutlinedStyle" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="32dp" app:cardElevation="1dp" app:cardBackgroundColor="@color/xingsui_paper_raised" app:strokeColor="#12282825" app:strokeWidth="1dp" app:contentPadding="0dp" android:layout_marginTop="16dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="我的奖励" android:textSize="18sp" android:textColor="@color/xingsui_ink" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textSize="34sp" android:textColor="@color/xingsui_ink" android:id="@+id/withdraw_balance" android:layout_marginTop="14dp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="可提现余额" android:textSize="11sp" android:textColor="@color/xingsui_muted" android:layout_marginTop="4dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/toggle_withdrawal" android:layout_width="match_parent" android:layout_height="56dp" android:text="提现与帮助  ›" android:textAllCaps="false" app:cornerRadius="20dp" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="18dp" style="?attr/materialButtonOutlinedStyle" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/withdrawal_form" android:visibility="gone" android:paddingTop="8dp">
              <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/xingsui_alipay_account" app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp" app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/alipay_account" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:singleLine="true" />
              </com.google.android.material.textfield.TextInputLayout>
              <com.google.android.material.button.MaterialButton android:id="@+id/submit_alipay_withdrawal" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/xingsui_submit_alipay_withdrawal" android:textAllCaps="false" app:cornerRadius="20dp" android:insetTop="0dp" android:insetBottom="0dp" android:enabled="false" android:layout_marginTop="12dp" />
              <com.google.android.material.button.MaterialButton android:id="@+id/copy_withdraw_wechat" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/xingsui_copy_withdraw_wechat" android:textAllCaps="false" app:cornerRadius="20dp" android:insetTop="0dp" android:insetBottom="0dp" android:layout_marginTop="8dp" style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>