<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#116366F1" />
            <stroke
                android:width="20dp"
                android:color="#226366F1" />
        </shape>
    </item>
    <item android:inset="2dp">
        <shape
            android:innerRadiusRatio="2.85"
            android:shape="ring"
            android:thickness="18dp"
            android:useLevel="false">
            <gradient
                android:angle="0"
                android:centerColor="#887C3AED"
                android:endColor="#004F46E5"
                android:startColor="#CC6366F1"
                android:type="sweep" />
        </shape>
    </item>
</layer-list>
