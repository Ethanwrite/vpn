<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#0B0B14" />
        </shape>
    </item>
    <item android:top="-160dp" android:left="-80dp" android:right="-80dp">
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="420dp"
                android:startColor="#423636B5"
                android:centerColor="#24202B66"
                android:endColor="#000B0B14" />
        </shape>
    </item>
    <item android:top="180dp" android:left="-120dp" android:right="-120dp">
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.15"
                android:centerY="0.2"
                android:gradientRadius="300dp"
                android:startColor="#2237D5F2"
                android:centerColor="#11181826"
                android:endColor="#000B0B14" />
        </shape>
    </item>
</layer-list>
